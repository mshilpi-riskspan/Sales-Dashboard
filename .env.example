VITE_SF_DOMAIN=login
VITE_SF_USERNAME="sfusername"
VITE_SF_PASSWORD='sfpassword'
VITE_SF_SECURITY_TOKEN="sfsecuritytoken"

# Snowflake — server-side only, no VITE_ prefix (must never reach the browser
# bundle). The role/user behind these credentials should be SELECT-only in
# Snowflake itself; the app also enforces read-only at the query layer.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----"
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=your_role

# Freshdesk — server-side only, no VITE_ prefix
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_DOMAIN=your_freshdesk_subdomain

# Jira — server-side only, no VITE_ prefix
JIRA_API_TOKEN=your_jira_api_token
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_USERNAME=your_atlassian_account_email

# Astronomer (Airflow) — server-side only, no VITE_ prefix
ASTRO_API_TOKEN=your_astro_api_token
ASTRO_BASE_URL=https://your-deployment.astronomer.run/your-org/api/v2

# Maxio (SaaSOptics) — server-side only, no VITE_ prefix
MAXIO_API_TOKEN=your_maxio_api_token
MAXIO_BASE_URL=https://yourorg.saasoptics.com/your_instance/api/v1.0
